{
  "name": "@checkdigit/eslint-config",
  "version": "12.2.0",
  "private": false,
  "description": "Check Digit standard eslint configuration",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript"
  ],
  "homepage": "https://github.com/checkdigit/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/checkdigit/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkdigit/eslint-config.git"
  },
  "license": "MIT",
  "author": "Check Digit, LLC",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs"
  ],
  "scripts": {
    "ci:compile": "tsc --noEmit",
    "ci:lint": "npm run lint",
    "ci:style": "npm run prettier",
    "ci:test": "npm run ci:compile && npm run ci:lint && npm run ci:style && npm run test:node",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "prepare": "",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "npm run ci:test",
    "test:node": "node --test-timeout 600000 --test \"src/config-contract.spec.ts\" \"src/deprecated-rules.spec.ts\""
  },
  "prettier": "@checkdigit/prettier-config",
  "dependencies": {
    "@checkdigit/eslint-athena-plugin": "2.0.1",
    "@checkdigit/eslint-plugin": "8.2.0-PR.151-b469",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-yml": "3.9.0",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@checkdigit/prettier-config": "^8.3.0",
    "@checkdigit/typescript-config": "^10.2.2",
    "fclone": "^1.0.11",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "10.8.1"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": false,
    "unrs-resolver@1.12.2": false
  }
}
